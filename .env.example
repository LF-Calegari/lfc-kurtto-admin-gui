# Porta do dev server (react-scripts) no container e no host. Padrão: 3001
PORT=3001

# Porta do nginx no perfil production (docker compose --profile production up web)
WEB_PORT=8081

# URL base do auth-service (lfc-authenticator), sem barra no final.
# Ex.: http://localhost:5052 ou https://localhost:8080 no Docker Compose da API.
REACT_APP_AUTH_API_URL=http://localhost:5052

# UUID do sistema cadastrado no auth-service para isolar este admin GUI.
# Enviado no body do login e no header X-System-Id em todas as chamadas autenticadas.
# Cada desenvolvedor deve trocar pelo UUID gerado no seu auth-service local;
# ausência da variável faz o cliente falhar em fail-fast antes de tocar a rede.
REACT_APP_SYSTEM_ID=9d95aea1-8b8f-482c-99ec-a84cda59d2d3

# URL base da kurtto-api (origem HTTP, sem /api/v1), sem barra no final.
# O cliente usa o prefixo /api/v1/urls conforme o contrato da API.
# Ex.: http://localhost:3000
REACT_APP_KURTTO_API_URL=http://localhost:3000
