# Porta do dev server (react-scripts) no container e no host. Padrão: 3001
PORT=3001

# Porta do nginx no perfil production (docker compose --profile production up web)
WEB_PORT=8081

# URL base do auth-service (lfc-authenticator), sem barra no final.
# Ex.: http://localhost:5052 ou https://localhost:8080 no Docker Compose da API.
REACT_APP_AUTH_API_URL=http://localhost:5052
